/* Quill Editor Global Styles with Dark Mode Support */

/* Base Quill Styles */
.ql-editor {
  font-size: 1rem;
  line-height: 1.625;
  color: #111827; /* gray-900 */
  font-family: 'Inter', system-ui, -apple-system, sans-serif;
  min-height: 400px;
  padding: 0;
  background-color: transparent;
  border: 1px solid #e5e7eb !important; /* gray-200 for light theme */
}

@media (prefers-color-scheme: dark) {
  .ql-editor {
    border-color: #6b7280 !important; /* gray-500 */
    color: #f3f4f6; /* gray-100 */
  }
}

.dark .ql-editor {
  border-color: #6b7280 !important; /* gray-500 */
  color: #f3f4f6; /* gray-100 */
}

.ql-editor.ql-blank::before {
  color: #9ca3af; /* gray-400 */
  font-style: italic;
  left: 0;
}

@media (prefers-color-scheme: dark) {
  .ql-editor.ql-blank::before {
    color: #6b7280; /* gray-500 */
  }
}

.dark .ql-editor.ql-blank::before {
  color: #6b7280; /* gray-500 */
}

/* Toolbar Styles */
.ql-toolbar {
  border: 0 !important;
  border-bottom: 1px solid #e5e7eb !important; /* gray-200 */
  background-color: #f9fafb !important; /* gray-50 */
}

@media (prefers-color-scheme: dark) {
  .ql-toolbar {
    border-bottom-color: #6b7280 !important; /* gray-500 */
    background-color: #374151 !important; /* gray-700 */
  }
}

.dark .ql-toolbar {
  border-bottom-color: #6b7280 !important; /* gray-500 */
  background-color: #374151 !important; /* gray-700 */
}

.ql-toolbar .ql-formats {
  @apply mr-4;
}

/* Toolbar buttons - Proper colors for both themes */
.ql-toolbar .ql-picker-label,
.ql-toolbar button {
  color: #6b7280 !important; /* gray-500 - lighter for light theme */
  transition: all 0.2s ease;
}

@media (prefers-color-scheme: dark) {
  .ql-toolbar .ql-picker-label,
  .ql-toolbar button {
    color: #e5e7eb !important; /* gray-200 */
  }
}

.dark .ql-toolbar .ql-picker-label,
.dark .ql-toolbar button {
  color: #e5e7eb !important; /* gray-200 */
}

.ql-toolbar button:hover {
  background-color: #e5e7eb !important; /* gray-200 */
  color: #111827 !important; /* gray-900 */
}

@media (prefers-color-scheme: dark) {
  .ql-toolbar button:hover {
    background-color: #4b5563 !important; /* gray-600 */
    color: #ffffff !important;
  }
}

.dark .ql-toolbar button:hover {
  background-color: #4b5563 !important; /* gray-600 */
  color: #ffffff !important;
}

.ql-toolbar button.ql-active {
  color: #2563eb !important; /* blue-600 */
  background-color: #eff6ff !important; /* blue-50 */
}

@media (prefers-color-scheme: dark) {
  .ql-toolbar button.ql-active {
    color: #60a5fa !important; /* blue-400 */
    background-color: rgba(30, 58, 138, 0.3) !important; /* blue-900/30 */
  }
}

.dark .ql-toolbar button.ql-active {
  color: #60a5fa !important; /* blue-400 */
  background-color: rgba(30, 58, 138, 0.3) !important; /* blue-900/30 */
}

/* Force icon colors with higher specificity */
.ql-toolbar button svg,
.ql-toolbar .ql-picker-label svg,
.ql-toolbar button .ql-stroke,
.ql-toolbar .ql-picker-label .ql-stroke {
  stroke: #6b7280 !important; /* gray-500 - lighter for light theme */
}

.ql-toolbar button .ql-fill,
.ql-toolbar .ql-picker-label .ql-fill {
  fill: #6b7280 !important; /* gray-500 - lighter for light theme */
}

@media (prefers-color-scheme: dark) {
  .ql-toolbar button svg,
  .ql-toolbar .ql-picker-label svg,
  .ql-toolbar button .ql-stroke,
  .ql-toolbar .ql-picker-label .ql-stroke {
    stroke: #e5e7eb !important; /* gray-200 */
  }

  .ql-toolbar button .ql-fill,
  .ql-toolbar .ql-picker-label .ql-fill {
    fill: #e5e7eb !important; /* gray-200 */
  }
}

.dark .ql-toolbar button svg,
.dark .ql-toolbar .ql-picker-label svg,
.dark .ql-toolbar button .ql-stroke,
.dark .ql-toolbar .ql-picker-label .ql-stroke {
  stroke: #e5e7eb !important; /* gray-200 */
}

.dark .ql-toolbar button .ql-fill,
.dark .ql-toolbar .ql-picker-label .ql-fill {
  fill: #e5e7eb !important; /* gray-200 */
}

/* Picker styles */
.ql-toolbar .ql-picker {
  color: #374151 !important; /* gray-700 - darker for better readability */
}

@media (prefers-color-scheme: dark) {
  .ql-toolbar .ql-picker {
    color: #e5e7eb !important; /* gray-200 */
  }
}

.dark .ql-toolbar .ql-picker {
  color: #e5e7eb !important; /* gray-200 */
}

.ql-toolbar .ql-picker-options {
  @apply bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-500 shadow-lg;
}

.ql-toolbar .ql-picker-item {
  @apply text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-600;
}

.ql-toolbar .ql-picker-item.ql-selected {
  @apply text-blue-600 dark:text-blue-400 bg-blue-50 dark:bg-blue-900/30;
}

/* Picker label improvements */
.ql-toolbar .ql-picker-label {
  @apply border border-transparent hover:border-gray-300 dark:hover:border-gray-500 rounded;
  color: #e5e7eb !important; /* gray-700 - darker for better readability */
}

.dark .ql-toolbar .ql-picker-label {
  color: #e5e7eb !important; /* gray-200 */
}

.ql-toolbar .ql-picker.ql-expanded .ql-picker-label {
  @apply border-gray-300 dark:border-gray-500;
}

.dark .ql-toolbar .ql-stroke {
  stroke: #e5e7eb;
}

/* Container styles */
.ql-container {
  @apply border-0 bg-transparent;
}

.ql-container.ql-snow {
  @apply border-0;
}

/* Editor focus styles */
.ql-editor:focus {
  @apply outline-none;
}

/* Content styles within editor */
.ql-editor h1,
.ql-editor h2,
.ql-editor h3,
.ql-editor h4,
.ql-editor h5,
.ql-editor h6 {
  @apply text-gray-900 dark:text-gray-100 font-bold;
}

.ql-editor h1 {
  @apply text-2xl mb-4;
}

.ql-editor h2 {
  @apply text-xl mb-3;
}

.ql-editor h3 {
  @apply text-lg mb-2;
}

.ql-editor p {
  @apply mb-3 text-gray-900 dark:text-gray-100;
}

.ql-editor blockquote {
  @apply border-l-4 border-gray-300 dark:border-gray-600 pl-4 italic text-gray-700 dark:text-gray-300 my-4;
}

.ql-editor code {
  @apply bg-gray-100 dark:bg-gray-800 text-gray-800 dark:text-gray-200 px-1 py-0.5 rounded text-sm;
}

.ql-editor pre {
  @apply bg-gray-100 dark:bg-gray-800 text-gray-800 dark:text-gray-200 p-4 rounded overflow-x-auto my-4;
}

.ql-editor ul,
.ql-editor ol {
  @apply pl-6 mb-4;
}

.ql-editor li {
  @apply mb-1 text-gray-900 dark:text-gray-100;
}

.ql-editor a {
  @apply text-blue-600 dark:text-blue-400 hover:text-blue-800 dark:hover:text-blue-300 underline;
}

.ql-editor img {
  @apply max-w-full h-auto rounded-lg shadow-sm;
}

/* Tooltip styles */
.ql-tooltip {
  @apply bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-600 shadow-lg;
}

.ql-tooltip input {
  @apply bg-white dark:bg-gray-700 text-gray-900 dark:text-gray-100 border border-gray-300 dark:border-gray-600;
}

.ql-tooltip .ql-action,
.ql-tooltip .ql-remove {
  @apply text-blue-600 dark:text-blue-400 hover:text-blue-800 dark:hover:text-blue-300;
}

/* Snow theme specific overrides */
.ql-snow .ql-tooltip[data-mode="link"]::before {
  content: "Ingresa el enlace:";
}

.ql-snow .ql-tooltip.ql-editing a.ql-action::after {
  content: "Guardar";
}

.ql-snow .ql-tooltip a.ql-action::after {
  content: "Editar";
}

.ql-snow .ql-tooltip a.ql-remove::before {
  content: "Eliminar";
}

/* Custom scrollbar for editor */
.ql-editor::-webkit-scrollbar {
  @apply w-2;
}

.ql-editor::-webkit-scrollbar-track {
  @apply bg-gray-100 dark:bg-gray-800;
}

.ql-editor::-webkit-scrollbar-thumb {
  @apply bg-gray-300 dark:bg-gray-600 rounded-full;
}

.ql-editor::-webkit-scrollbar-thumb:hover {
  @apply bg-gray-400 dark:bg-gray-500;
}