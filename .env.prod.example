# Archivo de ejemplo para variables de entorno de producción
# Copiar a .env.prod y ajustar los valores

# Database
DB_DATABASE=blogv2_prod
DB_USERNAME=blogv2_user
DB_PASSWORD=your_secure_database_password
DB_ROOT_PASSWORD=your_secure_root_password

# Redis
REDIS_PASSWORD=your_secure_redis_password

# Laravel
APP_KEY=base64:your_32_character_app_key_here
APP_URL=https://yourdomain.com

# Frontend
FRONTEND_API_BASE=https://api.yourdomain.com/api